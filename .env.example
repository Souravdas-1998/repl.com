# ============================================================
# StyleAI Clothing Store — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control
# ============================================================

# ─── Node ────────────────────────────────────────────────────
NODE_ENV=development                  # development | staging | production
LOG_LEVEL=info                        # trace | debug | info | warn | error

# ─── API Server ──────────────────────────────────────────────
PORT=5000                             # API server port
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/styleai
PGHOST=localhost
PGPORT=5432
PGUSER=styleai_user
PGPASSWORD=your_db_password
PGDATABASE=styleai

# ─── Frontend (Vite) ─────────────────────────────────────────
# Must be prefixed with VITE_ to be accessible on the client
VITE_API_BASE_URL=/api
BASE_PATH=/
PORT=3000                             # Vite dev server port (override API port above per service)

# ─── AI (Optional — set if using external AI provider) ───────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Docker / CI ─────────────────────────────────────────────
DOCKER_REGISTRY=your-ecr-or-dockerhub-registry
