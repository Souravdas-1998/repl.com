NODE_ENV=staging
LOG_LEVEL=info

PORT=5000
SESSION_SECRET=REPLACE_WITH_STAGING_SESSION_SECRET

DATABASE_URL=postgresql://styleai_stg:REPLACE_PASSWORD@staging-db.internal:5432/styleai_staging
PGHOST=staging-db.internal
PGPORT=5432
PGUSER=styleai_stg
PGPASSWORD=REPLACE_PASSWORD
PGDATABASE=styleai_staging

VITE_API_BASE_URL=/api
BASE_PATH=/

# OPENAI_API_KEY=sk-...

DOCKER_REGISTRY=REPLACE_REGISTRY
ECS_CLUSTER=styleai-cluster-staging
ECS_SERVICE_API=styleai-api-service
ECS_SERVICE_WEB=styleai-web-service
AWS_REGION=us-east-1
STAGING_URL=https://staging.styleai.example.com
